# Maven
target/
# Un-ignore any "target" directory that has "src" as an ancestor -- the engine module has a real
# source package named "target" (com.motorcardgame.engine.rule.target), which the bare pattern
# above would otherwise also match and silently hide from git.
!**/src/**/target/
!.mvn/wrapper/maven-wrapper.jar

# Java
*.class
*.log
hs_err_pid*

# IDE
.idea/
*.iml
*.iws
.vscode/
.claude/
.classpath
.project
.settings/
out/

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
.env.properties

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs/
*.log
